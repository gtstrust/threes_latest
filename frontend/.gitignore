# Secrets. `*.local` above does not match a plain `.env`, and neither does it
# match a hand-made copy — both have to be named. backend/.env.example was
# committed with live credentials once already; the block is cheaper than the
# rotation.
.env
.env.*
!.env.example
.env.backup-*
