# Copy to .env and fill in. NEVER put real credentials in this file — it is
# committed. .env is gitignored.
#
# Everything here ships to the browser: Vite inlines VITE_* at build time, so
# these values end up in a static asset that anyone can read. That is fine for
# the two below, and is exactly why the *secret* key must never appear here.

VITE_SUPABASE_URL=https://your-project.supabase.co

# The PUBLISHABLE key (sb_publishable_...), from Project Settings -> API keys.
# Not the secret key: that one bypasses row level security and belongs only in
# backend/.env. src/lib/env.ts refuses to start if it finds a secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Where FastAPI is listening. All data flows through it (ADR-001) — the browser
# never queries Supabase's database directly.
VITE_API_BASE_URL=http://localhost:8000

# Optional, and ON when unset. Offers signing in with a password as well as a
# magic link — a temporary bypass, because Supabase's built-in sender allows two
# messages an hour and the link often does not arrive.
#
# Set it to false and rebuild once custom SMTP is configured (docs/DEPLOYMENT.md
# section 3). Only "false" and "0" turn it off, so a typo leaves the bypass in
# place rather than silently removing the only way in.
VITE_ENABLE_PASSWORD_LOGIN=true
