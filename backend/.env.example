# Copy to .env and fill in real values once a Supabase project exists.
# Until then, the app boots fine with these placeholders — protected
# endpoints will 500 until SUPABASE_JWT_SECRET is set to a real value.
#
# NEVER put real credentials in this file — it is committed. They belong in
# .env, which is gitignored. The placeholders below are also load-bearing:
# app/core/config.py treats them as "unconfigured", which is what keeps a fresh
# checkout from broadcasting at a project that isn't yours.

# Realtime broadcasting (M9/ADR-010) switches itself on when SUPABASE_URL and
# SUPABASE_KEY hold real values. While they are the placeholders below it is a
# no-op, so a fresh checkout never POSTs at a project that doesn't exist.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# For running the app/tests directly on the host (venv) against the
# docker-compose postgres service, whose port is published to localhost:5433
# (5433, not 5432, to avoid clashing with any locally-installed Postgres).
# docker-compose itself overrides this to use the "postgres" service hostname
# (see docker-compose.yml) -- no need to change this file for that case.
# Point this at your Supabase project's Postgres connection string
# (postgresql+asyncpg://...) once one exists -- no code changes required.
DATABASE_URL=postgresql+asyncpg://threes:threes@localhost:5433/threes_dev

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
