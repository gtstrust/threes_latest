# macOS Finder metadata. Created in any directory the Finder has looked at, so
# it is ignored repo-wide rather than per-package.
.DS_Store

# Design canvas working files. The published canvas is the artefact; these are
# the source it is re-seeded from, and `.design-live/` is whatever was last read
# back out of it. Both are scratch — the canvas itself is the record.
.design/
.design-live/
